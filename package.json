{
  "name": "appdeck",
  "version": "0.1.0",
  "description": "A personal-first desktop workspace app for isolated, sleepable web services.",
  "main": "out/main/index.js",
  "author": "AppDeck",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run rebuild:node && vitest run",
    "test:e2e": "npm run rebuild:electron && npm run build && playwright test",
    "dist": "npm run build && npm run rebuild:electron && electron-builder --publish never -c.npmRebuild=false",
    "dist:portable": "npm run build && npm run rebuild:electron && electron-builder --win portable --publish never -c.npmRebuild=false",
    "release": "npm run build && npm run rebuild:electron && electron-builder --publish always -c.npmRebuild=false",
    "release:check": "powershell -ExecutionPolicy Bypass -File scripts/release-readiness.ps1",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "better-sqlite3": "12.11.1",
    "bip39": "3.1.0",
    "chokidar": "5.0.0",
    "electron-updater": "^6.8.9",
    "libsodium-wrappers-sumo": "0.8.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.4",
    "electron": "42.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.1",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
