{
  "name": "appdeck-sync",
  "version": "0.1.0",
  "private": true,
  "description": "AppDeck E2EE sync backend (Cloudflare Worker + D1).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create appdeck",
    "db:migrate": "wrangler d1 migrations apply appdeck --remote",
    "db:migrate:local": "wrangler d1 migrations apply appdeck --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4"
  }
}
